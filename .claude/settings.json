{
  "permissions": {
    "allow": [
      "Bash(python tools\\vba_check.py:*)",
      "Bash(python tools\\run_vba.py:*)",
      "Bash(python3 tools/vba_check.py:*)",
      "Bash(powershell -File tools\\check_merge.ps1:*)",
      "Bash(powershell.exe -File tools\\check_merge.ps1:*)",
      "Bash(git merge-tree:*)",
      "Bash(git merge-base:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git tag:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/vba-check.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/vba-test.sh\""
          }
        ]
      }
    ]
  }
}
