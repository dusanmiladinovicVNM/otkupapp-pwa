VERSION 1.0 CLASS
BEGIN
  MultiUse = -1  'True
END
Attribute VB_Name = "ThisWorkbook"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = True
Private Sub Workbook_Open()
    ' PRVA naredba, pre svega ostalog (v6-ui-214): od klika na fajl do ekrana
    ' operater ne sme da vidi listove. Monitor_AppOpen ispod je mrezni poziv --
    ' dok on traje sveska bi stajala otvorena na ekranu.
    '
    ' Bljesak dok Excel ucitava fajl (pre nego sto makro uopste krene) se odavde
    ' ne moze skratiti -- to radi Excel, ne mi.
    '
    ' Svaka grana koja odbija start (licenca, verzija, neuspela prijava, greska
    ' u EH ispod) sama vraca Visible = True pre svoje poruke.
    On Error Resume Next
    Application.Visible = False
    Monitor_AppOpen "Operator"
    On Error GoTo EH
    
    StartApp

    ' AUD-034a: licencni/trial gate je mozda odbio pristup -- prekini startup ODMAH,
    ' pre CleanupOrphanedLocks (Google) i pre laznog VBA_STARTUP_SUCCESS. Zatvaranje
    ' sveske je vec zakazano (DenyAccessAndScheduleClose -> OnTime ForceCloseDeniedWorkbook).
    If modLicense.AccessWasDenied() Then Exit Sub

    ' Stale lock cleanup (prethodna sesija crash-ovala ? lock ostao u SyncControl).
    ' Brisanje VBA-owned stanica lockova starijih od TTL (10 min).
    ' Fail-soft: ako Google nije dostupan, samo se loguje i ide dalje.
    On Error Resume Next
    modStanicaLock.CleanupOrphanedLocks
    On Error GoTo EH

    On Error Resume Next
    Monitor_Event _
        eventType:="VBA_STARTUP_SUCCESS", _
        severity:="INFO", _
        message:="Workbook startup completed", _
        userId:="Operator", _
        moduleName:="ThisWorkbook", _
        procedureName:="Workbook_Open", _
        entityType:="App", _
        entityID:="Startup", _
        correlationId:="VBA-STARTUP"
    On Error GoTo 0
    
    Exit Sub

EH:
    ' Err se cita PRVO, u lokale. Do sada je "On Error Resume Next" stajao na
    ' vrhu handlera, pa su i Monitor_Error i LogErr videli VEC RESETOVAN Err --
    ' telemetrija je prijavljivala gresku broj 0 sa praznim opisom, a u log nije
    ' isla nijedna linija. Pad pri pokretanju je tako ostajao bez ijednog traga.
    Dim errNum As Long, errDesc As String, errSrc As String
    errNum = Err.Number: errDesc = Err.description: errSrc = Err.SOURCE

    LogError "ThisWorkbook.Workbook_Open", errDesc, errNum

    On Error Resume Next
    Monitor_Error _
        moduleName:="ThisWorkbook", _
        procedureName:="Workbook_Open", _
        entityType:="App", _
        entityID:="Startup", _
        correlationId:="VBA-STARTUP", _
        errorNumber:=errNum, _
        errorDescription:=errDesc, _
        errorSource:=errSrc

    Application.Visible = True
    MsgBox Poruka("APP_MSG_GRESKA_PRI_POKRETANJU"), vbCritical
End Sub

' Globalna kapija nad Save-om. Postoji zato sto tri VBA puta (AutoSave, dugme
' "Snimi", gasenje aplikacije) NISU sva vrata: Ctrl+S, File > Save i Save As
' idu mimo svakog od njih. Dok stoji marker prekinutog VBA importa, projekat
' je mozda nepotpun i Save ga cini TRAJNIM -- 12.09.2026. je tako polomljen
' modLogo prezivio zatvaranje i ponovno otvaranje fajla.
'
' Self-update je izuzet po konstrukciji, ne slucajno:
' modSelfUpdate.PrepareRuntimeForSelfUpdate radi Application.EnableEvents =
' False pre ijedne izmene koda, pa ovaj event tada NE opali -- a njegov
' SaveWorkbookVerified je legitiman snimac popravljenog projekta. Da to ne bi
' ostalo na nadi, tools/vba_selfupdate_gates.py to i proverava kao kapiju.
'
' MsgBox je iza IsTestMode: u nevidljivom Excelu modalni dijalog ne puca nego
' trajno VISI. Cancel je invarijanta, poruka je samo UI.
Private Sub Workbook_BeforeSave(ByVal SaveAsUI As Boolean, Cancel As Boolean)
    On Error GoTo EH
    If modImportState.ImportNijeDovrsen() Then
        Cancel = True
        LogError "ThisWorkbook.Workbook_BeforeSave", _
                 "Save ODBIJEN: prekinut VBA import, projekat je mozda nepotpun.", 0, "WARN"
        If Not IsTestMode() Then
            MsgBox Poruka("APP_MSG_IMPORT_PREKINUT_NE_SNIMAM"), vbExclamation, APP_NAME
        End If
    End If
    Exit Sub
EH:
    LogErr "ThisWorkbook.Workbook_BeforeSave"
End Sub

Private Sub Workbook_BeforeClose(Cancel As Boolean)
    On Error GoTo EH
    
    ' Final release aktivne stanica lock-a. Ako forma nije zatvorena pre Excel
    ' close-a, ovde se hvata. Fail-soft: ako push padne (offline), lock ce
    ' postati stale i sledeca sesija ce ga ocistiti kroz CleanupOrphanedLocks.
    '
    ' Bulk push se NE radi bezuslovno -- odluku nosi modStanicaLock, jer je ovo
    ' poslednja brana bez obzira odakle je Close dosao. Pri prekinutom importu
    ' sveska se zatvara sa SaveChanges:=False, a push tada APPENDUJE red u cloud
    ' pa lokalni ClientRecordID marker -- jedini idempotency guard -- ode sa
    ' odbacenim promenama. Sledeca sesija bi iste redove poslala PONOVO
    ' (modStanicaLock.ReleaseActiveStanicaLock, isti razlog kao kod self-update-a).
    On Error Resume Next
    If Len(modStanicaLock.GetActiveStanica()) > 0 Then
        Application.StatusBar = "Sinhronizujem unos pre zatvaranja..."
        Application.Cursor = xlWait
        DoEvents

        modStanicaLock.ReleaseStanicaLockOnExit

        Application.StatusBar = False
        Application.Cursor = xlDefault
    End If
    On Error GoTo EH

    modMain.ShutdownApp

    Exit Sub

EH:
    LogErr "ThisWorkbook.Workbook_BeforeClose"
End Sub


