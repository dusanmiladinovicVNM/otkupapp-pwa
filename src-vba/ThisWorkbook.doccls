VERSION 1.0 CLASS
BEGIN
  MultiUse = -1  'True
END
Attribute VB_Name = "ThisWorkbook"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = True
Option Explicit

' ============================================================
' ThisWorkbook (KOD workbook).
'
' ENGINE rezim (.xlam): kad se Excel pokrene i add-in ucita, NE radimo
'   startup ovde (klijentski podaci jos nisu otvoreni). Umesto toga kacimo
'   Application-event oslukivac (clsAppEvents) koji ceka da se otvori
'   klijentski .xlsx i tek tada poziva modBoot.BootFromData.
'
' COMBINED rezim (.xlsm): kod i podaci su u istom fajlu, pa startujemo odmah.
'
' Sva startup/shutdown logika je u modBoot (centralno, deo koda/.xlam-a).
' ============================================================

Private Sub Workbook_Open()
    On Error Resume Next
    If ThisWorkbook.IsAddin Then
        modBoot.InstallAppEvents          ' ENGINE: oslukuj otvaranje klijentskog .xlsx
    Else
        modBoot.BootFromData ThisWorkbook ' COMBINED: kod + podaci zajedno
    End If
End Sub

Private Sub Workbook_BeforeClose(Cancel As Boolean)
    On Error Resume Next
    ' U ENGINE rezimu zatvaranje klijentskog .xlsx hvata clsAppEvents;
    ' zatvaranje samog add-in-a ne pokrece shutdown podataka.
    If ThisWorkbook.IsAddin Then Exit Sub
    modBoot.ShutdownFromData
End Sub
